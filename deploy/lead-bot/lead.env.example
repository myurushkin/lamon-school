# /etc/lamon/lead.env — секреты бота заявок. Права 600, владелец lending.
# MAX (основной канал: API доступен из России)
MAX_BOT_TOKEN=
MAX_USER_ID=
# Telegram (необязательно; с российских серверов api.telegram.org обычно недоступен)
TG_BOT_TOKEN=
TG_CHAT_ID=
LEAD_LOG=/var/lib/lamon/leads.jsonl
LISTEN_PORT=8081

# Почта: письмо на каждую заявку. Пароль приложения, не основной пароль ящика.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=bot@example.ru
SMTP_PASS=
MAIL_FROM=bot@example.ru
MAIL_TO=you@example.ru
