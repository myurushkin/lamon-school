---
// Линии уровня седловой функции z = x² − y²: гиперболы. Фоновый мотив лендингов.
interface Props { class?: string; stroke?: string; opacity?: number }
const { class: cls = "", stroke = "#1d4ed8", opacity = 0.18 } = Astro.props;
const W = 1200, H = 800, S = 120;
const paths: string[] = [];
const levels = [0.15, 0.4, 0.8, 1.3, 2, 2.9, 4, 5.4, 7];
for (const c of levels) {
  // x² − y² = c  → x = ±sqrt(c + y²); y² − x² = c → y = ±sqrt(c + x²)
  for (const sx of [1, -1]) {
    const pts: string[] = [];
    for (let y = -6; y <= 6; y += 0.1) { const x = sx * Math.sqrt(c + y * y); pts.push(`${(W / 2 + x * S).toFixed(1)},${(H / 2 + y * S).toFixed(1)}`); }
    paths.push(`<polyline points="${pts.join(" ")}"/>`);
  }
  for (const sy of [1, -1]) {
    const pts: string[] = [];
    for (let x = -6; x <= 6; x += 0.1) { const y = sy * Math.sqrt(c + x * x); pts.push(`${(W / 2 + x * S).toFixed(1)},${(H / 2 + y * S).toFixed(1)}`); }
    paths.push(`<polyline points="${pts.join(" ")}"/>`);
  }
}
// асимптоты
paths.push(`<line x1="0" y1="${H / 2 - W / 2}" x2="${W}" y2="${H / 2 + W / 2}"/>`, `<line x1="0" y1="${H / 2 + W / 2}" x2="${W}" y2="${H / 2 - W / 2}"/>`);
---
<svg class={`contours ${cls}`} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" fill="none" stroke={stroke} stroke-width="1" stroke-opacity={opacity} aria-hidden="true" set:html={paths.join("")} />
