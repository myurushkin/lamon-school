---
interface Props { applyHref?: string; cta?: string; standalone?: boolean }
const { applyHref = "/#apply", cta = "Записаться на звонок", standalone = false } = Astro.props;
---
<header>
  <div class="wrap nav">
    {standalone
      ? <span class="logo"><b>Lamon</b><span>Школа разработки искусственного интеллекта</span></span>
      : <a class="logo" href="/"><b>Lamon</b><span>Школа разработки искусственного интеллекта</span></a>}
    <a class="btn btn-primary btn-sm" href={applyHref}>{cta}</a>
  </div>
</header>
