---
// Седловая поверхность z = x² − y² в изометрии + точка, которая спускается к седлу,
// задерживается на нём и уходит вниз по долине. Внизу — кривая лосса по шагам.
// Чёрные линии на белом, без заливок. При prefers-reduced-motion — статичный кадр.
---
<svg class="fig hero-fig saddle" viewBox="0 0 460 460" fill="none" stroke="#000" stroke-width="1.1" aria-hidden="true" data-saddle>
  <g data-grid></g>
  <polyline data-trail stroke="#000" stroke-opacity=".7" stroke-width="1.6" stroke-dasharray="2 4" points=""/>
  <circle data-ball r="6" fill="#000" stroke="#fff" stroke-width="1.5"/>
  <circle data-saddle-pt r="3" fill="#fff" stroke="#000" stroke-width="1.2"/>
  <g data-loss transform="translate(106 356)">
    <line x1="0" y1="90" x2="260" y2="90"/>
    <polyline points="256,87 260,90 256,93"/>
    <line x1="0" y1="0" x2="0" y2="90"/>
    <polyline points="-3,4 0,0 3,4"/>
    <polyline data-loss-line stroke="#1d4ed8" stroke-width="1.8" points=""/>
    <text x="7" y="5" font-family="IBM Plex Mono, ui-monospace, monospace" font-size="11" fill="#000" stroke="none">loss</text>
    <text x="260" y="104" text-anchor="end" font-family="IBM Plex Mono, ui-monospace, monospace" font-size="11" fill="#000" stroke="none">итерация</text>
  </g>
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>("[data-saddle]");
  if (svg) {
    const grid = svg.querySelector<SVGGElement>("[data-grid]")!;
    const trail = svg.querySelector<SVGPolylineElement>("[data-trail]")!;
    const ball = svg.querySelector<SVGCircleElement>("[data-ball]")!;
    const saddlePt = svg.querySelector<SVGCircleElement>("[data-saddle-pt]")!;
    const lossLine = svg.querySelector<SVGPolylineElement>("[data-loss-line]")!;

    // поверхность и проекция
    const R = 1.4;                        // граница по x и y
    // седло в нуле, минимумы в (0, ±1) со значением −0.5: точка проходит седло и сходится в минимум
    const f = (x: number, y: number) => x * x - y * y + 0.5 * y ** 4;
    const F_MIN = -0.5;
    // поворот вокруг вертикали на A, наклон камеры E (взгляд сверху-сбоку)
    const CX = 236, CY = 168, S = 108, K = 52;
    const A = 0.55, E = 0.62;
    const cA = Math.cos(A), sA = Math.sin(A), sE = Math.sin(E), cE = Math.cos(E);
    const P = (x: number, y: number, z: number) => {
      const X = x * cA - y * sA, Yd = x * sA + y * cA;
      return [CX + X * S, CY + Yd * S * sE - z * K * cE] as const;
    };
    const pt = (x: number, y: number) => P(x, y, f(x, y));

    // поверхность из ячеек: заливка по глубине (ниже — насыщеннее синий, выше — белый),
    // рисуем от дальних к ближним, чтобы ближние перекрывали дальние
    const N = 14;
    const zs: number[] = [];
    for (let i = 0; i <= N; i++) for (let j = 0; j <= N; j++) zs.push(f(-R + (2 * R * i) / N, -R + (2 * R * j) / N));
    const zMin = Math.min(...zs), zMax = Math.max(...zs);
    type Quad = { depth: number; d: string; t: number };
    const quads: Quad[] = [];
    for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) {
      const x0 = -R + (2 * R * i) / N, x1 = -R + (2 * R * (i + 1)) / N;
      const y0 = -R + (2 * R * j) / N, y1 = -R + (2 * R * (j + 1)) / N;
      const c = [pt(x0, y0), pt(x1, y0), pt(x1, y1), pt(x0, y1)];
      const zc = (f(x0, y0) + f(x1, y0) + f(x1, y1) + f(x0, y1)) / 4;
      const xm = (x0 + x1) / 2, ym = (y0 + y1) / 2;
      quads.push({
        depth: xm * sA + ym * cA,                     // дальше от камеры — меньше
        d: `M${c.map(([px, py]) => `${px.toFixed(1)} ${py.toFixed(1)}`).join("L")}Z`,
        t: (zc - zMin) / (zMax - zMin),               // 0 — дно, 1 — верх
      });
    }
    quads.sort((a, b) => a.depth - b.depth);
    const frag = document.createDocumentFragment();
    for (const q of quads) {
      const el = document.createElementNS("http://www.w3.org/2000/svg", "path");
      el.setAttribute("d", q.d);
      // синий фирменный (29,78,216): на дне плотнее, наверху почти белый
      el.setAttribute("fill", `rgba(29,78,216,${(0.04 + 0.5 * (1 - q.t) ** 1.6).toFixed(3)})`);
      el.setAttribute("stroke", "rgba(0,0,0,0.75)");
      el.setAttribute("stroke-width", "0.8");
      el.setAttribute("stroke-linejoin", "round");
      frag.appendChild(el);
    }
    grid.appendChild(frag);
    const [sx, sy] = pt(0, 0);
    saddlePt.setAttribute("cx", sx.toFixed(1)); saddlePt.setAttribute("cy", sy.toFixed(1));

    // градиентный спуск с моментом и шумом: сначала к седлу по x, потом уход по y
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let x = 0, y = 0, vx = 0, vy = 0, step = 0;
    let trailPts: string[] = [], losses: number[] = [], f0 = 1;
    const LR = 0.002, MOM = 0.85, NOISE = 0.0005, NOISE_TAU = 400, MAX_STEPS = 300, TICK_MS = 46;

    function reset() {
      x = 1.15; y = (Math.random() < 0.5 ? -1 : 1) * 0.005; vx = 0; vy = 0; step = 0;
      trailPts = []; losses = []; f0 = f(x, y);
    }
    function draw() {
      const [bx, by] = pt(x, y);
      ball.setAttribute("cx", bx.toFixed(1)); ball.setAttribute("cy", by.toFixed(1));
      trail.setAttribute("points", trailPts.join(" "));
      // кривая лосса: идёт вправо по шагам, спадает к нулю с небольшими затухающими осцилляциями
      if (losses.length > 1) {
        const w = 260 / MAX_STEPS;
        lossLine.setAttribute("points", losses.map((l, i) => `${(i * w).toFixed(1)},${(90 - l * 82).toFixed(1)}`).join(" "));
      }
    }
    function tick() {
      // градиент z = x² − y²: (2x, −2y)
      const gx = 2 * x, gy = -2 * y + 2 * y ** 3;
      const out = Math.abs(y) > R || Math.abs(x) > R;
      if (!out) {
        const n = NOISE * Math.exp(-step / NOISE_TAU);
        vx = MOM * vx - LR * gx + (Math.random() - 0.5) * n;
        vy = MOM * vy - LR * gy + (Math.random() - 0.5) * n;
        x += vx; y += vy;
        const [bx, by] = pt(x, y);
        trailPts.push(`${bx.toFixed(1)},${by.toFixed(1)}`);
      }
      step++;
      // лосс = высота точки над минимумом, нормированная к старту: синхронно с движением
      const L = (f(x, y) - F_MIN) / (f0 - F_MIN);
      losses.push(Math.max(0, Math.min(1, L)));
      draw();
      if (step >= MAX_STEPS) {
        setTimeout(() => { reset(); }, 1600);
      }
    }
    reset();
    if (reduce) {
      // статичный кадр: вся траектория сразу
      for (let i = 0; i < MAX_STEPS; i++) tick();
    } else {
      let last = 0;
      const loop = (t: number) => {
        if (t - last > TICK_MS) { last = t; if (step < MAX_STEPS) tick(); }
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }
  }
</script>
