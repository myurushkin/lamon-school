---
---
<section class="sec" id="apply">
  <div class="wrap">
    <div class="apply">
      <div class="rv">
        <p class="eyebrow">Запись</p>
        <h2>Хочешь стать экспертом в&nbsp;области ИИ?</h2>
        <p class="lead">Запишись на звонок. Мы назначим встречу, где ты узнаешь подробности: как устроена учёба, кто ведёт, когда следующий набор и как в него попасть.</p>
      </div>
      <form id="form" class="rv" novalidate>
        <label>Как к вам обращаться
          <input name="name" type="text" required autocomplete="name" placeholder="Имя">
        </label>
        <label>Телефон
          <input name="phone" id="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+7 (___) ___-__-__" maxlength="18">
        </label>
        <button class="btn btn-primary" type="submit">Записаться на звонок</button>
        <p class="form-note">Нажимая кнопку, вы соглашаетесь, что мы свяжемся с вами по указанному телефону. Данные никому не передаём.</p>
        <div class="ok" id="ok">Спасибо! Заявка сформирована — мы свяжемся с вами в течение двух дней.</div>
      </form>
    </div>
  </div>
</section>

<script>
  const CONTACT = { email: "hello@lamon.school" };

  // маска российского номера: +7 (XXX) XXX-XX-XX
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  function formatRu(v: string){
    let d = v.replace(/\D/g,'');
    if(d.startsWith('8')) d = '7' + d.slice(1);
    if(d && !d.startsWith('7')) d = '7' + d;
    d = d.slice(0, 11);
    let out = '+7';
    if(d.length > 1) out += ' (' + d.slice(1, 4);
    if(d.length >= 4) out += ') ' + d.slice(4, 7);
    if(d.length >= 7) out += '-' + d.slice(7, 9);
    if(d.length >= 9) out += '-' + d.slice(9, 11);
    return out;
  }
  phoneInput?.addEventListener('input', () => {
    const d = phoneInput.value.replace(/\D/g,'');
    phoneInput.value = d ? formatRu(phoneInput.value) : '';
    phoneInput.setCustomValidity('');
  });
  phoneInput?.addEventListener('focus', () => { if(!phoneInput.value) phoneInput.value = '+7 ('; });
  phoneInput?.addEventListener('blur', () => { if(phoneInput.value.replace(/\D/g,'').length <= 1) phoneInput.value = ''; });
  phoneInput?.addEventListener('keydown', (e) => {
    // Backspace по скобке, пробелу или дефису удаляет предыдущую цифру
    if(e.key === 'Backspace' && phoneInput.selectionStart === phoneInput.selectionEnd){
      const pos = phoneInput.selectionStart ?? 0;
      if(pos > 0 && /\D/.test(phoneInput.value[pos - 1])){
        e.preventDefault();
        const d = phoneInput.value.replace(/\D/g,'').slice(0, -1);
        phoneInput.value = d.length > 1 ? formatRu(d) : '';
        const end = phoneInput.value.length; phoneInput.setSelectionRange(end, end);
      }
    }
  });
  const form = document.getElementById('form') as HTMLFormElement | null;
  form?.addEventListener('submit', (ev)=>{
    ev.preventDefault();
    const f = new FormData(form);
    const name = String(f.get('name')||'').trim(), phone = String(f.get('phone')||'').trim();
    const digits = phone.replace(/\D/g,'');
    const phoneEl = document.getElementById('phone') as HTMLInputElement | null;
    phoneEl?.setCustomValidity(digits.length === 11 ? '' : 'Введите номер полностью: +7 (XXX) XXX-XX-XX');
    if(!name || !phone || digits.length !== 11){ form.reportValidity(); return; }
    const body = [`Имя: ${name}`, `Телефон: ${phone}`].join('\n');
    const ok = document.getElementById('ok'); if(ok) ok.style.display = 'block';
    window.location.href = `mailto:${CONTACT.email}?subject=${encodeURIComponent('Запись на звонок: '+name)}&body=${encodeURIComponent(body)}`;
  });
</script>

