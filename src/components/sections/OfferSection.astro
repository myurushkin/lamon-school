---
interface Props {
  eyebrow?: string; title?: string; lead?: string; button?: string; source?: string;
  roles?: string[]; done?: string;
}
const {
  eyebrow = "Запись",
  title = "Хочешь стать экспертом в\u00a0области ИИ?",
  lead = "Запишись на звонок. Мы назначим встречу, где ты узнаешь подробности: как устроена учёба, кто ведёт, когда следующий набор и как в него попасть.",
  button = "Записаться на звонок",
  source = "main",
  roles = [],
  done = "Спасибо! Заявка отправлена — мы свяжемся с вами в течение двух дней.",
} = Astro.props;
---
<section class="sec" id="apply" data-done={done}>
  <div class="wrap">
    <div class="apply">
      <div class="rv">
        <p class="eyebrow">{eyebrow}</p>
        <h2 set:html={title} />
        <p class="lead">{lead}</p>
      </div>
      <form id="form" class="rv" novalidate>
        <label>Как к вам обращаться
          <input name="name" type="text" required autocomplete="name" placeholder="Имя">
        </label>
        <input type="hidden" name="source" value={source}>
        {roles.length > 0 && (
          <label>Кто вы
            <select name="role">
              {roles.map((r) => <option value={r}>{r}</option>)}
            </select>
          </label>
        )}
        <input name="site" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;height:0;width:0;opacity:0">
        <label>Телефон
          <input name="phone" id="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+7 (___) ___-__-__" maxlength="18">
        </label>
        <label>Напишите о своей ситуации
          <textarea name="about" maxlength="1000" placeholder="Пара слов о себе: где учитесь и что уже делали"></textarea>
        </label>
        <button class="btn btn-primary" type="submit">{button}</button>
        <p class="form-note">Нажимая кнопку, вы соглашаетесь, что мы свяжемся с вами по указанному телефону. Данные никому не передаём.</p>
        <div class="ok" id="ok">Спасибо! Заявка сформирована — мы свяжемся с вами в течение двух дней.</div>
      </form>
    </div>
  </div>
</section>

<script>
  const CONTACT = { email: "hello@lamon.school" };

  // маска российского номера: +7 (XXX) XXX-XX-XX
  const phoneInput = document.getElementById('phone') as HTMLInputElement | null;
  function formatRu(v: string){
    let d = v.replace(/\D/g,'');
    if(d.startsWith('8')) d = '7' + d.slice(1);
    if(d && !d.startsWith('7')) d = '7' + d;
    d = d.slice(0, 11);
    let out = '+7';
    if(d.length > 1) out += ' (' + d.slice(1, 4);
    if(d.length >= 4) out += ') ' + d.slice(4, 7);
    if(d.length >= 7) out += '-' + d.slice(7, 9);
    if(d.length >= 9) out += '-' + d.slice(9, 11);
    return out;
  }
  phoneInput?.addEventListener('input', () => {
    const d = phoneInput.value.replace(/\D/g,'');
    phoneInput.value = d ? formatRu(phoneInput.value) : '';
    phoneInput.setCustomValidity('');
  });
  phoneInput?.addEventListener('focus', () => { if(!phoneInput.value) phoneInput.value = '+7 ('; });
  phoneInput?.addEventListener('blur', () => { if(phoneInput.value.replace(/\D/g,'').length <= 1) phoneInput.value = ''; });
  phoneInput?.addEventListener('keydown', (e) => {
    // Backspace по скобке, пробелу или дефису удаляет предыдущую цифру
    if(e.key === 'Backspace' && phoneInput.selectionStart === phoneInput.selectionEnd){
      const pos = phoneInput.selectionStart ?? 0;
      if(pos > 0 && /\D/.test(phoneInput.value[pos - 1])){
        e.preventDefault();
        const d = phoneInput.value.replace(/\D/g,'').slice(0, -1);
        phoneInput.value = d.length > 1 ? formatRu(d) : '';
        const end = phoneInput.value.length; phoneInput.setSelectionRange(end, end);
      }
    }
  });
  const form = document.getElementById('form') as HTMLFormElement | null;
  const btn0 = form?.querySelector('button[type=submit]') as HTMLButtonElement | null;
  form?.addEventListener('submit', async (ev)=>{
    ev.preventDefault();
    const f = new FormData(form);
    const name = String(f.get('name')||'').trim(), phone = String(f.get('phone')||'').trim(), site = String(f.get('site')||'');
    const source = String(f.get('source')||''), role = String(f.get('role')||''), about = String(f.get('about')||'').trim().slice(0,1000);
    const doneText = (document.getElementById('apply') as HTMLElement | null)?.dataset.done || 'Спасибо! Заявка отправлена.';
    const btnText = btn0?.textContent || '';
    const digits = phone.replace(/\D/g,'');
    const phoneEl = document.getElementById('phone') as HTMLInputElement | null;
    phoneEl?.setCustomValidity(digits.length === 11 ? '' : 'Введите номер полностью: +7 (XXX) XXX-XX-XX');
    if(!name || !phone || digits.length !== 11){ form.reportValidity(); return; }
    const btn = btn0;
    const ok = document.getElementById('ok');
    if(btn){ btn.disabled = true; btn.textContent = 'Отправляем…'; }
    try {
      const r = await fetch('/api/lead', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, phone, site, source, role, about }) });
      const data = await r.json().catch(() => ({}));
      if(!r.ok || !data.ok) throw new Error(data.error || 'Не удалось отправить');
      if(ok){ ok.textContent = doneText; ok.style.display = 'block'; }
      try { if(typeof window.ym === 'function') window.ym(114311096, 'reachGoal', 'lead', { source, role }); } catch (_) {}
      form.reset();
      if(btn){ btn.textContent = 'Заявка отправлена'; }
    } catch (e) {
      // запасной путь: письмо через почтовый клиент
      if(ok){ ok.textContent = 'Не получилось отправить автоматически. Откроем письмо — просто нажмите «Отправить».'; ok.style.display = 'block'; }
      if(btn){ btn.disabled = false; btn.textContent = btnText; }
      const body = [`Имя: ${name}`, `Телефон: ${phone}`, role && `Кто: ${role}`, about && `О ситуации: ${about}`, `Страница: ${source}`].filter(Boolean).join('\n');
      window.location.href = `mailto:${CONTACT.email}?subject=${encodeURIComponent(btnText+': '+name)}&body=${encodeURIComponent(body)}`;
    }
  });
</script>

