---
const tracks = [
  {
    id: "track-research",
    n: "04",
    eyebrow: "Генеративный ИИ",
    title: "Опубликуйся на топовой конференции по ИИ",
    text: "Сделай исследование в генеративном ИИ, которое примут на конференцию уровня A*, и поезжай его представлять. Там ты познакомишься с исследователями из лучших лабораторий мира и станешь частью международного сообщества: именно так открываются стажировки и приглашения в ведущие лабы.",
    points: ["Статья на международной конференции с тобой в авторах", "Поездка на конференцию, знакомства с исследователями со всего мира", "Путь к стажировкам в ведущих лабораториях мира"],
    image: "/images/tracks/conference-hall.webp",
    imageAlt: "Пленарный зал международной конференции по ИИ: несколько тысяч исследователей",
    fig: '<polygon points="160,30 290,290 30,290"/><polygon points="160,120 230,260 90,260"/><circle cx="160" cy="215" r="6" fill="#000" stroke="none"/><line x1="160" y1="30" x2="160" y2="120"/>',
  },
  {
    id: "track-bio",
    n: "01",
    eyebrow: "Биомоделирование",
    title: "Погрузись в поиск лекарства от рака",
    text: "Работай с моделями молекул и ДНК на стыке математики, квантовой химии и биологии. Задачи берутся из реальных исследований: поиск структур в геноме, анализ тандемных повторов, предсказание свойств соединений, которые могут стать лекарством.",
    points: ["Данные и модели из действующих научных проектов", "Публикации в журналах Elsevier как ориентир результата", "Работа рядом с химиками и биологами, а не только с кодом"],
    fig: '<circle cx="160" cy="160" r="110"/><circle cx="160" cy="160" r="60"/><circle cx="160" cy="160" r="14"/><line x1="30" y1="160" x2="290" y2="160"/><circle cx="270" cy="160" r="6" fill="#000" stroke="none"/><circle cx="100" cy="160" r="6" fill="#000" stroke="none"/>',
  },
  {
    id: "track-startup",
    n: "02",
    eyebrow: "ИИ-стартап",
    title: "Запусти ИИ-стартап и получи финансирование для масштабирования",
    text: "Пройди путь от идеи до продукта, которым пользуются: анализ рынка, данные, модель, первые клиенты. Даём знания, которые позволяют запускать ИТ-продукты из любой точки мира. Рядом те, кто построил ИИ-компанию BroutonLab и запускает продукты для клиентов в США, Европе и Латинской Америке.",
    points: ["Анализ рынка и проверка идеи на реальных клиентах, а не на презентации", "Команда, инфраструктура и первые продажи", "Запуск и развитие продукта удалённо, из любой страны"],
    fig: '<rect x="30" y="30" width="260" height="260"/><line x1="30" y1="160" x2="290" y2="160"/><line x1="160" y1="30" x2="160" y2="290"/><rect x="160" y="30" width="130" height="130" fill="#000" stroke="none"/><circle cx="95" cy="225" r="6" fill="#000" stroke="none"/>',
  },
];
---
{tracks.map((t, i) => (
  <section class={`sec track-sec ${i % 2 ? "track-rev" : ""}`} id={t.id}>
    <div class="wrap">
      <div class="track-grid rv">
        <div class="track-body">
          <h2>{t.title}</h2>
          <p class="lead">{t.text}</p>
          <ul class="track-points">
            {t.points.map((p) => <li>{p}</li>)}
          </ul>
          <div class="cta-row" style="margin-top:28px">
            <a class="btn btn-primary" href="#apply">Записаться на звонок</a>
          </div>
        </div>
        {"image" in t && t.image
          ? <img class="track-img" src={t.image} alt={(t as any).imageAlt ?? ""} width="1600" height="1067" loading="lazy" />
          : <svg class="fig track-fig" viewBox="0 0 320 320" fill="none" stroke="#000" stroke-width="1.25" aria-hidden="true" set:html={t.fig} />}
      </div>
    </div>
  </section>
))}
