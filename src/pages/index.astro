---
import Base from "../layouts/Base.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import Case from "../components/Case.astro";
import TracksSection from "../components/sections/TracksSection.astro";
import TeachersRow from "../components/sections/TeachersRow.astro";
import WorksSection from "../components/sections/WorksSection.astro";
import PlacesSection from "../components/sections/PlacesSection.astro";
import OfferSection from "../components/sections/OfferSection.astro";
---
<Base
  title="Lamon — Школа разработки искусственного интеллекта"
  description="Lamon — лучшая школа в области разработки искусственного интеллекта для школьников и студентов. Исследования уровня A*, ИИ-стартапы, партнёры по всему миру. Запишись на звонок."
>
<main id="top">
  <HeroSection />
  <Case />
  <TracksSection />
  <TeachersRow />
  <WorksSection />
  <PlacesSection />
  <OfferSection />
</main>
</Base>
