---
// Главная временно скрыта: полная версия лежит в /draft/ и дорабатывается.
import Base from "../layouts/Base.astro";
import HeroFigure from "../components/sections/HeroFigure.astro";
import OfferSection from "../components/sections/OfferSection.astro";
---
<Base title="Lamon — Школа разработки искусственного интеллекта" description="Lamon — школа разработки искусственного интеллекта в Ростове-на-Дону. Для школьников и студентов." applyHref="#apply">
<main id="top">
  <section class="hero">
    <div class="wrap">
      <div>
        <h1>Школа разработки искусственного интеллекта</h1>
        <p class="lead">Ростов-на-Дону и онлайн. Для школьников и студентов. Сайт обновляется, но на звонок можно записаться уже сейчас.</p>
        <div class="cta-row"><a class="btn btn-primary" href="#apply">Записаться на звонок</a></div>
      </div>
      <HeroFigure />
    </div>
  </section>
  <OfferSection source="main-stub" />
</main>
</Base>
