---
// Вариант A «Ландшафт»: линии уровня седловой функции, анимированная поверхность,
// фото во всю ширину, чёрная секция задач, синяя форма.
import "../../styles/landing.css";
import Base from "../../layouts/Base.astro";
import Contours from "../../components/Contours.astro";
import HeroFigure from "../../components/sections/HeroFigure.astro";
import TeachersRow from "../../components/sections/TeachersRow.astro";
import PlacesSection from "../../components/sections/PlacesSection.astro";
import OfferSection from "../../components/sections/OfferSection.astro";
import { hero, caseBlock, tasks, steps, gains, route, honest, offer, differ } from "../../data/students";
---
<Base title="Lamon для студентов — вариант A" description="Исследования в ИИ с первого курса. Ростов-на-Дону и онлайн." applyHref="#apply" standalone>
<main id="top" class="landing">
  <section class="lhero">
    <Contours />
    <div class="wrap">
      <div>
        <p class="kicker">{hero.kicker}</p>
        <h1>{hero.h1}</h1>
        <p class="lead">{hero.lead}</p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#apply">Записаться на звонок</a>
          <a class="btn btn-ghost" href="#tasks">Какие задачи</a>
        </div>
        <div class="facts">{hero.facts.map((f) => <span>{f}</span>)}</div>
      </div>
      <HeroFigure />
    </div>
  </section>

  <section class="lcase">
    <img src="/images/tracks/conference-hall.webp" alt="Пленарный зал EMNLP 2026" width="1600" height="1067" loading="eager" />
    <div class="stamp">{caseBlock.stamp}</div>
    <div class="wrap"><div class="text">
      <h2>{caseBlock.title}</h2>
      <p class="lead">{caseBlock.text}</p>
      <p class="paper">Работа: «{caseBlock.paper}»</p>
    </div></div>
  </section>

  <section class="sec dark has-bg" id="tasks">
    <Contours stroke="#3b6cf0" opacity={0.35} />
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Чем ты будешь заниматься</p>
        <h2>Задачи уже есть. Нужны те, кто их сделает</h2>
        <p class="lead">Самое сложное в науке — найти задачу, которая того стоит. Эту часть мы берём на себя: у каждой команды есть постановка, данные и понятный результат.</p>
      </div>
      <div class="tasks">
        {tasks.map((t) => (
          <div class="col"><span class="n">{t.n}</span><h3>{t.title}</h3><p>{t.text}</p><ul>{t.items.map((i) => <li>{i}</li>)}</ul></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Как это устроено</p>
        <h2>Не лекции, а работа над задачей вместе с теми, кто уже умеет</h2>
        <p class="lead">Мы не читаем курс по математике и программированию. Мы учим искать информацию, выбирать инструменты, ставить эксперименты и доводить до результата, который можно показать.</p>
      </div>
      <div class="steps">
        {steps.map((s) => (<div class="step"><div class="step-when">{s.when}</div><div><h3>{s.title}</h3><p>{s.text}</p></div></div>))}
      </div>
    </div>
  </section>

  <section class="sec" id="gains">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Что это даёт</p><h2>Опыт, который не получить на парах</h2></div>
      <div class="gains">
        {gains.map((g) => (<div class="gain"><span class="mark"></span><h3>{g.title}</h3><p>{g.text}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec" id="differ" style="border-top:1px solid var(--line)">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Чем это отличается</p><h2>Не курс, не кружок и не лаборатория</h2></div>
      <div class="cols">
        {differ.map((d) => (<div class="col"><h3>{d.title}</h3><p>{d.text}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec" id="next">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Ближайшие цели</p>
        <h2>Куда подаём работы в 2027 году</h2>
        <p class="lead">Работы, которые команды начинают сейчас, готовятся к воркшопам и shared tasks конференций 2027 года. Чтобы быть автором, нужно войти в команду до старта задачи.</p>
      </div>
      <div class="route">
        {route.map((r) => (<div class={`stop ${r.blue ? "blue" : ""}`}><p class="date">{r.date}</p><p class="place">{r.place} · {r.sub}</p><p>{r.text}</p></div>))}
      </div>
    </div>
  </section>

  <section class="sec wash" id="honest">
    <div class="wrap">
      <div class="sec-head"><p class="eyebrow">Честно</p><h2>Что мы не обещаем</h2></div>
      <div class="honest">{honest.map((h) => (<div class="rule"><b>{h.b}</b><p>{h.p}</p></div>))}</div>
    </div>
  </section>

  <TeachersRow />
  <PlacesSection />
  <div class="offer-blue">
    <OfferSection eyebrow="Запись" title={offer.title} lead={offer.lead} source="students-a" />
  </div>
</main>
</Base>
