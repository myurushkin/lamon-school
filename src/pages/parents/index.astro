---
import Base from "../../layouts/Base.astro";
import Case from "../../components/Case.astro";
import TeachersRow from "../../components/sections/TeachersRow.astro";
import PlacesSection from "../../components/sections/PlacesSection.astro";
import OfferSection from "../../components/sections/OfferSection.astro";

const gains = [
  { title: "Настоящее дело вместо учебных примеров", text: "Ребёнок работает в команде над задачей с реальными данными и понятным результатом: статья на международной конференции или работающий продукт. Не «проект для галочки», а то, что потом можно показать." },
  { title: "Умение учиться самостоятельно", text: "Мы не пересказываем учебник. Руководитель ставит задачу, показывает, где искать, и разбирает непонятное. Ребёнок учится находить информацию, проверять идеи и доводить начатое до конца." },
  { title: "Речь, презентации, работа с людьми", text: "Каждую неделю участники рассказывают команде, что сделали. Перед выступлениями руководитель проверяет презентацию и разбирает ошибки. Это навыки, которых школа почти не даёт." },
  { title: "Понимание, куда поступать", text: "Искусственный интеллект сейчас нужен в химии, биологии, медицине, экономике. Попробовав задачу из области изнутри, ребёнок выбирает направление осознанно, а не по названию факультета." },
  { title: "Своя среда", text: "Вокруг ребёнка студенты и исследователи, которые занимаются тем же. Для школьника, которому в классе не с кем обсудить нейросети, это часто важнее всего остального." },
  { title: "Трек, который не обрывается после школы", text: "Мы преподаём на мехмате ЮФУ и работаем со студентами. Поступив, ребёнок продолжает в той же команде и с тем же руководителем, а не начинает с нуля." },
];
const how = [
  { when: "Знакомство", title: "Звонок и встреча", text: "Разговариваем с вами и с ребёнком: что умеет, что интересно, сколько времени готов уделять. Решаем вместе, подходит ли формат сейчас или стоит подойти через полгода." },
  { when: "Старт", title: "Задача и команда под ребёнка", text: "Группы небольшие и собираются по навыкам, а не по возрасту. Школьник может оказаться в одной команде со студентом, если уровень позволяет. Руководитель подбирает задачу и роль так, чтобы было по силам и интересно." },
  { when: "Каждую неделю", title: "Семинар и работа между встречами", text: "Очно в Ростове или онлайн. На семинаре команды показывают результаты и получают разбор. Между встречами ребёнок работает над своей частью, руководитель на связи." },
  { when: "Постоянно", title: "Внимание к тому, как ребёнок растёт", text: "Руководитель видит, что получается, а что нет, и меняет задачи под это. Занятий один на один мы не проводим: сила формата в команде, но путь у каждого свой." },
];
---
<Base
  title="Lamon для родителей — исследования в ИИ для школьников 9–11 классов"
  description="Школа разработки искусственного интеллекта в Ростове-на-Дону. Школьники работают в командах со студентами и исследователями над задачами, которые доходят до международных конференций. Отбор по навыкам."
  applyHref="#apply"
  standalone
>
<main id="top">
  <section class="hero hero-simple">
    <div class="wrap">
      <p class="eyebrow">Для родителей школьников 9–11 классов</p>
      <h1>Если ваш ребёнок перерос кружки по&nbsp;программированию</h1>
      <p class="lead">Lamon — школа разработки искусственного интеллекта в Ростове-на-Дону. Школьники работают в командах вместе со студентами и исследователями над задачами, которые доходят до международных конференций. Ведут учёные с мехмата ЮФУ и инженеры ИИ-компании, чьи работы приняты на конференции уровня A*.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#apply">Записаться на звонок</a>
        <a class="btn btn-ghost" href="#gains">Что это даёт</a>
      </div>
      <div class="facts">
        <span>Очно в Ростове и онлайн</span>
        <span>Небольшие группы</span>
        <span>Отбор по навыкам, а не по возрасту</span>
      </div>
    </div>
  </section>

  <Case />

  <section class="sec" id="gains">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Что это даёт ребёнку</p>
        <h2>Опыт, который обычно появляется только после университета</h2>
      </div>
      <div class="cols">
        {gains.map((g) => (
          <div class="col"><h3>{g.title}</h3><p>{g.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="how">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Как устроены занятия</p>
        <h2>Команда, задача и руководитель, который следит за результатом</h2>
      </div>
      <div class="steps">
        {how.map((s) => (
          <div class="step">
            <div class="step-when">{s.when}</div>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="who">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Кому подходит</p>
        <h2>Кого мы берём</h2>
      </div>
      <div class="who">
        <div class="col">
          <h3>Подойдёт, если ребёнок</h3>
          <ul>
            <li>учится в 9–11 классе, лучше в физико-математическом или ИТ-классе;</li>
            <li>уже пишет код на Python или быстро его освоит;</li>
            <li>сам интересуется нейросетями, а не только по вашей инициативе;</li>
            <li>готов уделять делу несколько часов в неделю помимо школы.</li>
          </ul>
        </div>
        <div class="col">
          <h3>Не подойдёт, если нужно</h3>
          <ul>
            <li>подготовиться к ЕГЭ или подтянуть школьную программу;</li>
            <li>занятия строго один на один с преподавателем;</li>
            <li>гарантированная публикация или победа в конкурсе;</li>
            <li>занять ребёнка, которому это неинтересно.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" id="honest">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Честно</p>
        <h2>О чём говорим сразу</h2>
      </div>
      <div class="honest">
        <div class="rule"><b>Мы не заменяем репетитора по ЕГЭ</b><p>Поступление в бакалавриат решают баллы. Мы работаем на то, что будет после: магистратура, стажировки, работа. И на то, чтобы ребёнок понял, чем хочет заниматься, до подачи документов.</p></div>
        <div class="rule"><b>Не гарантируем публикацию</b><p>Решение о принятии работы принимают рецензенты конференции. Мы отвечаем за то, что работа будет сделана честно и доведена до подачи.</p></div>
        <div class="rule"><b>Требуем участия</b><p>Пропуски без причины ведут к отчислению. Так мы держим уровень группы, ради которого к нам приходят сильные ребята.</p></div>
      </div>
    </div>
  </section>

  <TeachersRow />
  <PlacesSection />
  <OfferSection
    eyebrow="Запись"
    title="Подходит ли формат вашему ребёнку?"
    lead="Запишитесь на звонок. Расскажем, как проходит отбор, какие задачи стартуют ближайшими и сколько времени потребуется от ребёнка. Ни к чему не обязывает."
    source="parents"
    roles={["Родитель", "Школьник", "Другое"]}
  />
</main>
</Base>
