---
import Base from "../../layouts/Base.astro";
import TeachersRow from "../../components/sections/TeachersRow.astro";
import PlacesSection from "../../components/sections/PlacesSection.astro";
import OfferSection from "../../components/sections/OfferSection.astro";

const agenda = [
  { t: "20 мин", title: "Чем живёт мировой NLP в 2026 году", text: "Что обсуждали на главной конференции по обработке языка: агенты, retrieval, оценка LLM, эффективные модели. Какие направления растут, какие уже остыли." },
  { t: "20 мин", title: "Как работа из Ростова попала на EMNLP", text: "Разбор нашей статьи: откуда взялась задача, что не получалось, как устроены рецензирование и подача. Без прикрас." },
  { t: "20 мин", title: "Как попасть туда самому", text: "Shared tasks и воркшопы, где начинают студенты. Что нужно уметь, сколько это занимает времени и с чего начать в этом году." },
  { t: "30 мин", title: "Вопросы и разговор", text: "Останемся, пока есть вопросы. Можно подойти с идеей задачи или просто познакомиться с теми, кто этим занимается в Ростове." },
];
---
<Base
  title="Открытая встреча Lamon — что было на EMNLP 2026"
  description="Бесплатная открытая встреча в Ростове-на-Дону, ул. Надёжная, 82: исследователи, вернувшиеся с EMNLP 2026 в Будапеште, рассказывают, чем живёт мировой NLP и как туда попасть студенту. Запишитесь, пришлём дату и адрес."
  applyHref="#apply"
  standalone
  cta="Хочу прийти"
>
<main id="top">
  <section class="hero hero-simple">
    <div class="wrap">
      <p class="eyebrow">Открытая встреча · бесплатно · Ростов-на-Дону, ул. Надёжная, 82</p>
      <h1>Что было на&nbsp;главной мировой конференции по&nbsp;NLP в&nbsp;2026 году</h1>
      <p class="lead">Мы только что вернулись с EMNLP 2026 в Будапеште, где представляли работу, сделанную в Ростове. Расскажем, что происходит в мировом генеративном ИИ прямо сейчас, как устроена наука изнутри и что нужно, чтобы попасть на такую конференцию студенту. Полтора часа, живьём, с вопросами.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#apply">Хочу прийти</a>
        <a class="btn btn-ghost" href="#agenda">Программа</a>
      </div>
      <div class="facts">
        <span>Для студентов и старших школьников</span>
        <span>Вход свободный, по записи</span>
        <span>Надёжная, 82 · дату пришлём на телефон</span>
      </div>
    </div>
  </section>

  <section class="case" id="case">
    <div class="wrap case-grid">
      <div class="case-photo">
        <img src="/images/tracks/conference-hall.webp" alt="Пленарный зал EMNLP 2026 в Будапеште" loading="eager" width="1200" height="800" />
      </div>
      <div class="case-text">
        <h2>EMNLP — одна из трёх главных конференций мира по обработке языка</h2>
        <p class="lead">Несколько тысяч исследователей из университетов и лабораторий со всего мира. Туда попадает небольшая доля поданных работ. В 2026 году среди них была наша.</p>
      </div>
    </div>
  </section>

  <section class="sec" id="agenda">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Программа</p>
        <h2>Полтора часа без воды</h2>
      </div>
      <div class="agenda">
        {agenda.map((a) => (
          <div class="row"><div class="t">{a.t}</div><p><b>{a.title}</b>{a.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="sec" id="who">
    <div class="wrap">
      <div class="sec-head">
        <p class="eyebrow">Кому будет полезно</p>
        <h2>Приходите, если</h2>
      </div>
      <div class="who">
        <div class="col">
          <h3>Вы студент</h3>
          <ul>
            <li>нравится ML или NLP, а заняться этим всерьёз в вузе негде;</li>
            <li>хотите понять, как устроены исследования и конференции, не по статьям, а от людей;</li>
            <li>думаете о стажировке, магистратуре или работе в ИИ.</li>
          </ul>
        </div>
        <div class="col">
          <h3>Вы школьник или родитель</h3>
          <ul>
            <li>ребёнок пишет код и интересуется нейросетями;</li>
            <li>хочется увидеть, чем занимаются исследователи, и спросить лично;</li>
            <li>решаете, куда поступать и чем заниматься дальше.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <TeachersRow />
  <PlacesSection />
  <OfferSection
    eyebrow="Запись на встречу"
    title="Приходите, вход свободный"
    lead="Встреча пройдёт в нашем офисе на улице Надёжной, 82. Оставьте имя и телефон, пришлём дату и время, как только соберётся группа. Мест немного, поэтому по записи."
    button="Хочу прийти"
    source="open"
    done="Спасибо! Записали вас. Дату и время пришлём на этот номер."
  />
</main>
</Base>
